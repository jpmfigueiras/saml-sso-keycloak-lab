{
  "strict": true,
  "debug": true,
  "sp": {
    "entityId": "gid-fastapi-saml",
    "assertionConsumerService": {
      "url": "http://localhost:8000/auth/saml/acs",
      "binding": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST"
    },
    "singleLogoutService": {
      "url": "http://localhost:8000/auth/saml/sls",
      "binding": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect"
    },
    "NameIDFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified"
  },
  "idp": {
    "entityId": "http://localhost:8080/realms/gid-dev",
    "singleSignOnService": {
      "url": "http://localhost:8080/realms/gid-dev/protocol/saml",
      "binding": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect"
    },
    "singleLogoutService": {
      "url": "http://localhost:8080/realms/gid-dev/protocol/saml",
      "binding": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect"
    },
    "x509cert": "RUN_scripts/sync_idp_cert.py"
  },
  "security": {
    "authnRequestsSigned": false,
    "wantAssertionsSigned": true,
    "wantMessagesSigned": false
  }
}
